 {
  "name": "camera_snapshot",
  "description": "Capture ONE still frame from a PC camera as PNG (base64).\n\n    Placement is read-side (screenshot's sibling), but this is NOT a\n    silent read: the call goes through toolcall with write=True so the\n    ApprovalRequested audit event fires and plan mode cannot execute\n    it, and the provider runs its own always_ask approval gate before\n    opening the camera (privacy MF-1/MF-2). device: camera index or\n    name; default first camera. One call = one frame.",
  "inputSchema": {
   "properties": {
    "device": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Device"
    },
    "max_width": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Width"
    }
   },
   "title": "camera_snapshotArguments",
   "type": "object"
  }
 },
